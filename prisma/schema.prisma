generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model amenity {
  id              Int               @id @default(autoincrement())
  name            String            @unique(map: "Amenity_name_key") @db.VarChar(100)
  description     String?           @db.Text
  icon            String?           @db.VarChar(50)
  category        String?           @db.VarChar(50)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  propertyamenity propertyamenity[]
}

model comuna {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(100)
  regionId  Int
  createdAt DateTime   @default(now())
  updatedAt DateTime
  region    region     @relation(fields: [regionId], references: [id], onDelete: Cascade, map: "Comuna_regionId_fkey")
  landlord  landlord[]
  property  property[]
  student   student[]

  @@index([name, regionId], map: "Comuna_name_regionId_idx")
  @@index([regionId], map: "Comuna_regionId_idx")
}

model landlord {
  id                Int            @id @default(autoincrement())
  landlordRut       String         @unique(map: "Landlord_landlordRut_key")
  landlordEmail     String         @unique(map: "Landlord_landlordEmail_key")
  landlordName      String
  password          String
  landlordCarnetUrl String
  role              String         @default("landlord")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime
  comunaId          Int
  regionId          Int
  profilePhotoUrl   String?
  comuna            comuna         @relation(fields: [comunaId], references: [id], map: "Landlord_comuna_fkey")
  region            region         @relation(fields: [regionId], references: [id], map: "Landlord_region_fkey")
  property          property[]
  refreshtoken      refreshtoken[]

  @@index([comunaId], map: "Landlord_comunaId_idx")
  @@index([regionId], map: "Landlord_regionId_idx")
}

model property {
  id                   Int                   @id @default(autoincrement())
  landlordId           Int
  title                String
  description          String?               @db.Text
  address              String
  propertyType         property_propertyType
  bedrooms             Int
  bathrooms            Int
  squareMeters         Float?
  monthlyRent          Decimal               @db.Decimal(10, 2)
  isAvailable          Boolean               @default(true)
  utilityBillUrl       String
  utilityBillValidated Boolean               @default(false)
  latitude             Decimal?              @db.Decimal(10, 8)
  longitude            Decimal?              @db.Decimal(11, 8)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime
  comunaId             Int
  regionId             Int
  comuna               comuna                @relation(fields: [comunaId], references: [id], map: "Property_comuna_fkey")
  landlord             landlord              @relation(fields: [landlordId], references: [id], onDelete: Cascade, map: "Property_landlordId_fkey")
  region               region                @relation(fields: [regionId], references: [id], map: "Property_region_fkey")
  propertyamenity      propertyamenity[]
  propertyimage        propertyimage[]

  @@index([comunaId], map: "Property_comunaId_idx")
  @@index([landlordId], map: "Property_landlordId_idx")
  @@index([regionId], map: "Property_regionId_idx")
}

model propertyamenity {
  id         Int      @id @default(autoincrement())
  propertyId Int
  amenityId  Int
  createdAt  DateTime @default(now())
  amenity    amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade, map: "PropertyAmenity_amenityId_fkey")
  property   property @relation(fields: [propertyId], references: [id], onDelete: Cascade, map: "PropertyAmenity_propertyId_fkey")

  @@unique([propertyId, amenityId], map: "PropertyAmenity_propertyId_amenityId_key")
  @@index([amenityId], map: "PropertyAmenity_amenityId_idx")
  @@index([propertyId], map: "PropertyAmenity_propertyId_idx")
}

model propertyimage {
  id           Int      @id @default(autoincrement())
  propertyId   Int
  imageUrl     String   @db.VarChar(500)
  displayOrder Int      @default(0)
  altText      String?  @db.VarChar(255)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  property     property @relation(fields: [propertyId], references: [id], onDelete: Cascade, map: "PropertyImage_propertyId_fkey")

  @@index([propertyId, displayOrder], map: "PropertyImage_propertyId_displayOrder_idx")
  @@index([propertyId, isPrimary], map: "PropertyImage_propertyId_isPrimary_idx")
}

model refreshtoken {
  id         Int       @id @default(autoincrement())
  token      String    @unique(map: "RefreshToken_token_key") @db.VarChar(500)
  studentId  Int?
  landlordId Int?
  userType   String    @db.VarChar(20)
  isRevoked  Boolean   @default(false)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  landlord   landlord? @relation(fields: [landlordId], references: [id], onDelete: Cascade, map: "RefreshToken_landlord_fkey")
  student    student?  @relation(fields: [studentId], references: [id], onDelete: Cascade, map: "RefreshToken_student_fkey")

  @@index([expiresAt], map: "RefreshToken_expiresAt_idx")
  @@index([landlordId], map: "RefreshToken_landlordId_idx")
  @@index([studentId], map: "RefreshToken_studentId_idx")
  @@index([token], map: "RefreshToken_token_idx")
}

model region {
  id          Int        @id @default(autoincrement())
  code        String     @unique(map: "Region_code_key") @db.VarChar(10)
  name        String     @db.VarChar(100)
  romanNumber String     @db.VarChar(10)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  comuna      comuna[]
  landlord    landlord[]
  property    property[]
  student     student[]

  @@index([code], map: "Region_code_idx")
}

model student {
  id                    Int            @id @default(autoincrement())
  studentRut            String         @unique(map: "Student_studentRut_key")
  studentEmail          String         @unique(map: "Student_studentEmail_key")
  studentName           String
  password              String
  studentCollege        String
  studentCertificateUrl String
  role                  String
  createdAt             DateTime       @default(now())
  updatedAt             DateTime
  comunaId              Int
  regionId              Int
  profilePhotoUrl       String?
  refreshtoken          refreshtoken[]
  comuna                comuna         @relation(fields: [comunaId], references: [id], map: "Student_comuna_fkey")
  region                region         @relation(fields: [regionId], references: [id], map: "Student_region_fkey")

  @@index([comunaId], map: "Student_comunaId_idx")
  @@index([regionId], map: "Student_regionId_idx")
}

enum property_propertyType {
  APARTMENT
  HOUSE
  ROOM
}
