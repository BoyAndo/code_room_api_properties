// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// MODELOS DE USUARIOS
// ============================================

model Student {
  id                    Int      @id @default(autoincrement())
  studentRut            String   @unique
  studentEmail          String   @unique
  studentName           String
  password              String
  studentCollege        String
  studentCertificateUrl String
  profilePhotoUrl       String?
  role                  String
  comunaId              Int      // Foreign key a Comuna (obligatorio)
  regionId              Int      // Foreign key a Region (obligatorio)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  // Relaciones de ubicación
  comuna                Comuna   @relation(fields: [comunaId], references: [id], onDelete: Restrict, map: "Student_comuna_fkey")
  region                Region   @relation(fields: [regionId], references: [id], onDelete: Restrict, map: "Student_region_fkey")
  
  // Relación con refresh tokens
  refreshTokens         RefreshToken[]
  
  @@index([comunaId])
  @@index([regionId])
}

model Landlord {
  id                Int      @id @default(autoincrement())
  landlordRut       String   @unique
  landlordEmail     String   @unique
  landlordName      String
  password          String
  landlordCarnetUrl String
  profilePhotoUrl   String?
  role              String   @default("landlord")
  comunaId          Int      // Foreign key a Comuna (obligatorio)
  regionId          Int      // Foreign key a Region (obligatorio)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relación con propiedades
  properties        Property[]
  
  // Relaciones de ubicación
  comuna            Comuna   @relation(fields: [comunaId], references: [id], onDelete: Restrict, map: "Landlord_comuna_fkey")
  region            Region   @relation(fields: [regionId], references: [id], onDelete: Restrict, map: "Landlord_region_fkey")
  
  // Relación con refresh tokens
  refreshTokens     RefreshToken[]
  
  @@index([comunaId])
  @@index([regionId])
}

// ============================================
// MODELOS DE PROPIEDADES (para referencia)
// ============================================

// Enum para tipos de propiedad
enum PropertyType {
  APARTMENT
  HOUSE
  ROOM
}

model Property {
  id                    Int      @id @default(autoincrement())
  landlordId            Int      // Foreign key al landlord
  title                 String
  description           String?  @db.Text
  address               String
  comunaId              Int      // Foreign key a Comuna
  regionId              Int      // Foreign key a Region
  latitude              Decimal    @db.Decimal(10, 7) // Almacenar latitud con alta precisión
  longitude             Decimal    @db.Decimal(10, 7) // Almacenar longitud con alta precisión
  propertyType          PropertyType
  bedrooms              Int
  bathrooms             Int
  squareMeters          Float?
  monthlyRent           Decimal  @db.Decimal(10, 2)
  isAvailable          Boolean  @default(true)
  utilityBillUrl        String
  utilityBillValidated  Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  // Relaciones
  landlord              Landlord          @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  comuna                Comuna            @relation(fields: [comunaId], references: [id], onDelete: Restrict, map: "Property_comuna_fkey")
  region                Region            @relation(fields: [regionId], references: [id], onDelete: Restrict, map: "Property_region_fkey")
  propertyImages        PropertyImage[]
  propertyAmenities     PropertyAmenity[]
  
  @@index([landlordId])
  @@index([comunaId])
  @@index([regionId])
}

model PropertyImage {
  id           Int      @id @default(autoincrement())
  propertyId   Int
  imageUrl     String   @db.VarChar(500)
  displayOrder Int      @default(0)
  altText      String?  @db.VarChar(255)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  @@index([propertyId, displayOrder])
  @@index([propertyId, isPrimary])
}

model Amenity {
  id                Int                @id @default(autoincrement())
  name              String             @unique @db.VarChar(100)
  description       String?            @db.Text
  icon              String?            @db.VarChar(50)
  category          String?            @db.VarChar(50)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  
  propertyAmenities PropertyAmenity[]
}

model PropertyAmenity {
  id         Int      @id @default(autoincrement())
  propertyId Int
  amenityId  Int
  createdAt  DateTime @default(now())
  
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  
  @@unique([propertyId, amenityId])
  @@index([propertyId])
  @@index([amenityId])
}

// ============================================
// MODELOS DE UBICACIÓN (CHILE)
// ============================================

model Region {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(10) // Ej: "RM", "V", "VIII"
  name        String   @db.VarChar(100) // Ej: "Región Metropolitana"
  romanNumber String   @db.VarChar(10)  // Ej: "XIII"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relaciones
  comunas     Comuna[]
  properties  Property[]
  students    Student[]
  landlords   Landlord[]
  
  @@index([code])
}

model Comuna {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100) // Ej: "Santiago", "Las Condes"
  regionId  Int      // Foreign key a Region
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relaciones
  region      Region     @relation(fields: [regionId], references: [id], onDelete: Cascade)
  properties  Property[]
  students    Student[]
  landlords   Landlord[]
  
  @@index([regionId])
  @@index([name, regionId])
}

// ============================================
// MODELO DE REFRESH TOKENS
// ============================================

model RefreshToken {
  id          Int       @id @default(autoincrement())
  token       String    @unique @db.VarChar(500) // El refresh token JWT
  studentId   Int?      // ID del estudiante (nullable)
  landlordId  Int?      // ID del landlord (nullable)
  userType    String    @db.VarChar(20) // "student" o "landlord"
  isRevoked   Boolean   @default(false) // Para invalidar tokens
  expiresAt   DateTime  // Fecha de expiración
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relaciones polimórficas
  student     Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade, map: "RefreshToken_student_fkey")
  landlord    Landlord? @relation(fields: [landlordId], references: [id], onDelete: Cascade, map: "RefreshToken_landlord_fkey")
  
  @@index([token])
  @@index([studentId])
  @@index([landlordId])
  @@index([expiresAt])
}