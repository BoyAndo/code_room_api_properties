// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// MODELOS DE USUARIOS (de api_register)
// ============================================

model Student {
  id                    Int      @id @default(autoincrement())
  studentRut            String   @unique
  studentEmail          String   @unique
  studentName           String
  password              String
  studentCollege        String
  studentCertificateUrl String
  role                  String
  regionId              Int?
  comunaId              Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  // Relaciones
  region                Region?  @relation("StudentRegion", fields: [regionId], references: [id])
  comuna                Comuna?  @relation("StudentComuna", fields: [comunaId], references: [id])
  
  @@index([regionId])
  @@index([comunaId])
}

model Landlord {
  id                Int      @id @default(autoincrement())
  landlordRut       String   @unique
  landlordEmail     String   @unique
  landlordName      String
  password          String
  landlordCarnetUrl String
  role              String   @default("landlord")
  regionId          Int?
  comunaId          Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relaciones
  properties        Property[]
  region            Region?  @relation("LandlordRegion", fields: [regionId], references: [id])
  comuna            Comuna?  @relation("LandlordComuna", fields: [comunaId], references: [id])
  
  @@index([regionId])
  @@index([comunaId])
}

// ============================================
// MODELOS DE PROPIEDADES (api_properties)
// ============================================

// Modelos de ubicación (Region y Comuna)
model Region {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(10)
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relaciones
  comunas   Comuna[]
  students  Student[] @relation("StudentRegion")
  landlords Landlord[] @relation("LandlordRegion")
  properties Property[] @relation("PropertyRegion")
}

model Comuna {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  regionId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relaciones
  region     Region     @relation(fields: [regionId], references: [id], onDelete: Cascade)
  students   Student[] @relation("StudentComuna")
  landlords  Landlord[] @relation("LandlordComuna")
  properties Property[] @relation("PropertyComuna")
  
  @@index([regionId])
}

// Enum para tipos de propiedad
enum PropertyType {
  APARTMENT
  HOUSE
  ROOM
}

model Property {
  id                    Int      @id @default(autoincrement())
  landlordId            Int      // Foreign key al landlord (ahora en la misma BD)
  title                 String
  description           String?  @db.Text
  address               String
  regionId              Int
  comunaId              Int
  zipCode               String?
  propertyType          PropertyType
  bedrooms              Int
  bathrooms             Int
  squareMeters          Float?
  monthlyRent           Decimal  @db.Decimal(10, 2)
  isAvailable          Boolean  @default(true)
  utilityBillUrl        String   // URL de la cuenta de servicios validada
  utilityBillValidated  Boolean  @default(false)
  rules                 String?  @db.Text
  latitude              Decimal? @db.Decimal(10, 8)
  longitude             Decimal? @db.Decimal(11, 8)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  // Relaciones
  landlord              Landlord          @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  region                Region            @relation("PropertyRegion", fields: [regionId], references: [id])
  comuna                Comuna            @relation("PropertyComuna", fields: [comunaId], references: [id])
  propertyImages        PropertyImage[]
  propertyAmenities     PropertyAmenity[]
  
  @@index([landlordId])
  @@index([regionId])
  @@index([comunaId])
}

model PropertyImage {
  id           Int      @id @default(autoincrement())
  propertyId   Int
  imageUrl     String   @db.VarChar(500)
  displayOrder Int      @default(0)
  altText      String?  @db.VarChar(255)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relación con propiedad
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Índices para performance
  @@index([propertyId, displayOrder])
  @@index([propertyId, isPrimary])
}

// Modelo para amenities (características de la propiedad)
model Amenity {
  id                Int                @id @default(autoincrement())
  name              String             @unique @db.VarChar(100)
  description       String?            @db.Text
  icon              String?            @db.VarChar(50) // Para iconos en el frontend
  category          String?            @db.VarChar(50) // "utilities", "recreation", "security", etc.
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  
  // Relación con propiedades
  propertyAmenities PropertyAmenity[]
}

// Tabla pivot/join para la relación many-to-many entre Property y Amenity
model PropertyAmenity {
  id         Int      @id @default(autoincrement())
  propertyId Int
  amenityId  Int
  createdAt  DateTime @default(now())
  
  // Relaciones
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  
  // Índices y constrains
  @@unique([propertyId, amenityId]) // Evitar duplicados
  @@index([propertyId])
  @@index([amenityId])
}

